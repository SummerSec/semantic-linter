{
  "description": "语义陷阱检测器 - 会话启动时注入语义约束规则指针，引导模型按需自查指令文件中的宽边界词",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
